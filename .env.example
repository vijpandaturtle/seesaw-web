# Where your seesaw checkout keeps its run artifacts. The job store defaults to
# <SEESAW_OUTPUTS_DIR>/jobs.db, so setting this alone is usually enough.
#
# Defaults to ../seesaw/outputs, which works if the two repos sit side by side.
SEESAW_OUTPUTS_DIR=/absolute/path/to/seesaw/outputs

# Override only if the database lives somewhere other than the outputs dir.
# SEESAW_DB_PATH=/absolute/path/to/seesaw/outputs/jobs.db

# ── Running jobs from this app ───────────────────────────────────────────────
# Set this to your seesaw checkout and the dashboard starts a worker itself
# whenever you create or approve a job — no second terminal needed.
#
# Leave it unset when this app is deployed away from the agents: jobs are then
# queued for `python -m orchestrator.src.worker --poll` to claim.
SEESAW_REPO_DIR=/absolute/path/to/seesaw

# Interpreter for the worker. Defaults to <SEESAW_REPO_DIR>/.venv/bin/python,
# falling back to python3.
# SEESAW_PYTHON=/absolute/path/to/seesaw/.venv/bin/python
